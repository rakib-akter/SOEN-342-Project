@startuml book-appointment-find-patient
title Communication Diagram - UC1 Book Appointment: findPatient (CO1)
skinparam linetype polyline

label " " as start
rectangle "<u>:AppointmentSystem</u>" as ctrl
rectangle "<u>patient:Patient</u>" as patient

start -right- ctrl : "findPatient(insuranceNumber, dateOfBirth,\nphoneNumber, firstName, lastName) >"
ctrl -- patient : "1*: [for each patient in patients]\nok := matches(insuranceNumber, dateOfBirth,\nphoneNumber, firstName, lastName) >"

note right of ctrl
  returns every patient
  for which ok is true
end note

note bottom of patient
  checks its own fields and
  insuranceNumbers
end note
@enduml

@startuml book-appointment-find-patient
title Communication Diagram - UC1 Book Appointment: findPatient (CO1)
skinparam linetype polyline

label " " as start
rectangle "<u>:AppointmentSystem</u>" as ctrl
rectangle "<u>p:Patient</u>" as p

start -right- ctrl : "findPatient(insuranceNumber, dateOfBirth,\nphoneNumber, firstName, lastName) >"
ctrl -- p : "1*: [for each p in patients]\nok := matches(insuranceNumber, dateOfBirth,\nphoneNumber, firstName, lastName) >"

note right of ctrl
  returns every p
  for which ok is true
end note

note bottom of p
  checks its own fields and
  insuranceNumbers
end note
@enduml

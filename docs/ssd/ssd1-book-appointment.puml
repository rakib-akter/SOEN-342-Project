@startuml ssd1-book-appointment
title SSD - UC1: Book Appointment (success and failure scenarios)
hide footbox
skinparam sequenceMessageAlign center

actor ":AdministrativeStaff" as staff
participant ":System" as sys

note over staff, sys : Precondition: user (administrative staff or patient) is identified and authenticated;\na patient booking for themselves follows the same flow

loop patient not yet identified
    staff -> sys : findPatient(criteria)
    alt one or more patients match (main, 3b)
        sys --> staff : matching patients
    else no patient matches (3a - FAILURE)
        sys --> staff : no patient found
        note over staff, sys : Staff refines the search;\nif the patient is not registered, the use case ends
    end
end

staff -> sys : selectMedicalService(patientId, serviceId)
break service requires a referral and patient has none active (5a - FAILURE)
    sys --> staff : referral required
    note over staff, sys : Use case ends without booking an appointment
end
sys --> staff : service accepted,\nactive referrals (if the service requires one) (5b)

loop no suitable slot yet
    note over staff, sys : <<include>> Search Availability (see SSD4)
    staff -> sys : searchAvailability(professionalId, specialtyName,\nlocationId, fromDate, toDate)
    alt slots available (main)
        sys --> staff : available slots
    else no suitable slot (5c - FAILURE)
        sys --> staff : no available slots
        opt patient asks to join the waitlist (<<extend>> Join Waitlist)
            staff -> sys : joinWaitlist(professionalId, specialtyName,\nfromDate, toDate, priority)
            sys --> staff : waitlist entry confirmation
            note over staff, sys : Use case ends without booking an appointment
        end
        note over staff, sys : Otherwise staff searches again, or the use case ends
    end
end

loop selected slot cannot be booked
    staff -> sys : bookAppointment(slotId, referralId)
    alt slot still available and required resources free (main)
        note over staff, sys : <<extend>> Allocate Resources: if the service requires resources,\nthe system allocates them during booking
        sys --> staff : confirmation with appointment details\n(and allocated resources)
    else slot taken before booking was completed (7a)
        sys --> staff : slot unavailable, updated slots
    else a required room or equipment is taken at that time (FAILURE)
        sys --> staff : required resources unavailable for this slot
        note over staff, sys : Staff selects another slot
    end
end

@enduml
